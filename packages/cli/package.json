{
  "name": "@contextbridge/cli",
  "version": "0.1.0",
  "bin": {
    "cb": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && pnpm build:bundle",
    "build:bundle": "node scripts/bundle.mjs",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@contextbridge/core": "workspace:*",
    "@contextbridge/sdk": "workspace:*",
    "better-sqlite3": "^11.10.0",
    "chalk": "^5.4.0",
    "chokidar": "^5.0.0",
    "commander": "^13.0.0",
    "ora": "^8.2.0",
    "sqlite-vec": "^0.1.9",
    "tree-sitter": "^0.25.0",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
